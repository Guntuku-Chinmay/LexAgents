# LexAgents Environment Variables Example

# LLM API configuration
# Defaults to OpenAI. For other providers, modify BASE_URL and API_KEY.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Configurable models
# You can use "gpt-4o-mini" for faster/cheaper runs and "gpt-4o" for complex tasks.
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB setting
QDRANT_STORAGE_PATH=data/qdrant_db

# SQLite Database
SQLITE_DB_PATH=backend/app/database/lexagents.db

# Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Enable/Disable Web Search Agent
WEB_SEARCH_ENABLED=True
