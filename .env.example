# LexAgents Environment Variables Example

# LLM API configuration
# Defaults to OpenAI. For other providers, modify BASE_URL and API_KEY.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Configurable models
# You can use "gpt-4o-mini" for faster/cheaper runs and "gpt-4o" for complex tasks.
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB settings
# Leave empty for local file storage (will fall back to QDRANT_STORAGE_PATH)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Local directory path used if QDRANT_URL is not set
QDRANT_STORAGE_PATH=data/qdrant_db

# Relational Database settings
# Leave empty for local SQLite (will fall back to SQLITE_DB_PATH)
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/lexagents

# Local SQLite path used if DATABASE_URL is not set
SQLITE_DB_PATH=backend/app/database/lexagents.db

# API settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Frontend API Endpoint (Next.js build time variable)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Enable/Disable Web Search Agent
WEB_SEARCH_ENABLED=True

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://lex-agents.vercel.app
